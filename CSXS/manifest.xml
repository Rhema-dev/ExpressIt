<?xml version="1.0" encoding="UTF-8"?>

<ExtensionManifest
    Version="7.0"
    ExtensionBundleId="com.khua.expressit"
    ExtensionBundleName="ExpressIt"
    ExtensionBundleVersion="1.0.0">

    <ExtensionList>
        <Extension
            Id="com.khua.expressit.panel"
            Version="1.0.0" />
    </ExtensionList>

    <ExecutionEnvironment>

        <HostList>
            <Host Name="AEFT" Version="[25.0,26.0)" />
        </HostList>

        <LocaleList>
            <Locale Code="All" />
        </LocaleList>

        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="12.0" />
        </RequiredRuntimeList>

    </ExecutionEnvironment>

    <DispatchInfoList>

        <Extension Id="com.khua.expressit.panel">

            <DispatchInfo>

                <Resources>
                    <MainPath>./dist/index.html</MainPath>
                    <ScriptPath>./host/expressit.jsx</ScriptPath>
                </Resources>

                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>

                <UI>

                    <Type>Panel</Type>

                    <Menu>ExpressIt</Menu>

                    <Geometry>

                        <Size>
                            <Width>360</Width>
                            <Height>650</Height>
                        </Size>

                        <MinSize>
                            <Width>300</Width>
                            <Height>400</Height>
                        </MinSize>

                        <MaxSize>
                            <Width>1000</Width>
                            <Height>2000</Height>
                        </MaxSize>

                    </Geometry>

                </UI>

            </DispatchInfo>

        </Extension>

    </DispatchInfoList>

</ExtensionManifest>
